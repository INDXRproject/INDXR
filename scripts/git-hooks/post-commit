#!/bin/bash
# INDXR post-commit hook — appends a one-line commit summary to docs/COMMITS.md.
#
# HISTORY: this used to append to docs/LOG.md and fold the append into the commit via
# `git commit --amend`. Two problems:
#   1. It bloated LOG.md with 700+ machine "commit:/Changed:" blocks that nobody reads —
#      LOG.md is meant for hand-written session entries (read at session start).
#   2. The whole-file `git add docs/LOG.md` swept a *concurrent session's* uncommitted LOG.md
#      line into an unrelated commit on the amend (this happened: bf9d222).
#
# FIX (2026-08-08): the machine commit-summary now goes to docs/COMMITS.md, which is GITIGNORED
# and is NOT amended into the commit:
#   - LOG.md stays purely hand-written (no machine bloat); git log remains the real history and
#     docs/COMMITS.md is just a flat local convenience mirror of it.
#   - no `--amend` → commit SHAs are stable, and the concurrency-sweep bug is structurally gone:
#     the hook never runs `git add` and never amends, so it can never stage another session's work.
#   - the working tree stays clean because docs/COMMITS.md is gitignored.
#
# No recursion guard is needed: without `--amend`, post-commit does not re-fire.
#
# This file is the tracked canonical copy. Install it with:
#   cp scripts/git-hooks/post-commit .git/hooks/post-commit && chmod +x .git/hooks/post-commit
REPO_ROOT=$(git rev-parse --show-toplevel)
COMMITS="$REPO_ROOT/docs/COMMITS.md"
CHANGED_FILES=$(git -C "$REPO_ROOT" diff-tree --no-commit-id -r --name-only HEAD)
COMMIT_MSG=$(git -C "$REPO_ROOT" log -1 --pretty=%B)
TIMESTAMP=$(date '+%Y-%m-%d %H:%M')

{
  echo "[$TIMESTAMP] commit: $COMMIT_MSG"
  echo "Changed: $CHANGED_FILES"
  echo "---"
} >> "$COMMITS"

echo "post-commit: appended commit summary to docs/COMMITS.md (gitignored, not amended; LOG.md untouched)."
